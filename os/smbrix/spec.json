{
  "name": "SMBrix",
  "version": "0.1.0",
  "status": "planning",
  "created": "2026-08-06",
  "target_hardware": {
    "device": "HP Chromebook 14-SMB",
    "cpu": {
      "model": "Intel Celeron 2955U",
      "architecture": "x86_64",
      "microarchitecture": "Haswell",
      "cores": 2,
      "threads": 2,
      "base_clock_ghz": 1.4,
      "cache_l3_mb": 2,
      "tdp_w": 15
    },
    "gpu": {
      "model": "Intel HD Graphics (Haswell)",
      "type": "integrated",
      "driver_target": "i915"
    },
    "ram": {
      "size_gb": 4,
      "type": "DDR3L",
      "channels": 1
    },
    "storage": {
      "internal": {
        "type": "eMMC",
        "size_gb": 16
      },
      "expansion": ["SD card"]
    },
    "display": {
      "size_in": 14,
      "resolution": "1366x768",
      "type": "TN LCD"
    },
    "connectivity": {
      "wifi": "Intel Dual Band Wireless-AC 7260",
      "bluetooth": "4.0",
      "usb": ["2x USB 2.0", "1x USB 3.0"],
      "video_out": ["HDMI"],
      "audio": "Intel HD Audio",
      "sd_card": true,
      "ethernet": false
    },
    "firmware": {
      "type": "UEFI",
      "provider": "MrChromebox",
      "secure_boot": false
    },
    "battery": {
      "estimated_life_hrs": 8
    }
  },
  "os": {
    "base": "Debian minimal",
    "base_candidates": ["Debian minimal", "Ubuntu Server", "Kali (stripped)"],
    "kernel": "linux",
    "kernel_notes": "Custom config targeting Haswell microarchitecture, eMMC storage, i915 GPU, iwlwifi for Intel 7260",
    "kernel_optimizations": [
      "CONFIG_MHASWELL — Haswell CPU tuning",
      "Enable eMMC (CONFIG_MMC, CONFIG_MMC_SDHCI)",
      "i915 Intel GPU driver (CONFIG_DRM_I915)",
      "iwlwifi for Intel 7260 WiFi (CONFIG_IWLWIFI)",
      "Disable unused drivers (SCSI tape, floppy, parallel port, etc.)",
      "Enable WireGuard (CONFIG_WIREGUARD)",
      "Enable cgroups + namespaces for containerization"
    ],
    "gui": {
      "include": "undecided",
      "candidates": ["none (CLI only)", "Openbox + tint2", "LXQt"],
      "note": "Decision deferred until base footprint is measured against 16GB eMMC budget"
    },
    "init_system": "systemd",
    "package_manager": "apt",
    "primary_interface": "CLI",
    "terminal": {
      "multiplexer": "tmux",
      "multiplexer_notes": "Split panes, multiple windows, session persistence — no GUI required. Replaces Terminator for CLI-first workflow.",
      "shell": "bash",
      "shell_candidates": ["bash", "zsh", "fish"]
    },
    "vpn_support": {
      "method": "CLI only",
      "clients": [
        "Tailscale — mesh VPN, zero-config peer-to-peer, CLI via tailscale up/down/status",
        "WireGuard (wg-quick) — manual config, raw tunnels",
        "OpenVPN — traditional VPN, wide server compatibility",
        "nmcli — NetworkManager CLI for any configured VPN"
      ],
      "tailscale_notes": "Preferred VPN for remote access. Runs as a daemon (tailscaled), WireGuard-based under the hood. Install via official apt repo."
    },
    "core_packages": {
      "networking": ["NetworkManager", "iwd", "nmap", "curl", "wget"],
      "terminal": ["tmux", "vim", "htop", "tree", "bat", "fzf"],
      "system": ["sudo", "ufw", "logrotate", "cron", "rsync"],
      "vpn": ["tailscale", "wireguard-tools", "openvpn"],
      "hardware": ["firmware-iwlwifi", "intel-microcode", "thermald"]
    },
    "storage_budget": {
      "total_gb": 16,
      "partitions": {
        "efi_mb": 512,
        "swap_gb": 2,
        "root_gb": 10,
        "home_gb": 3.5
      },
      "notes": "Tight budget — no large desktop environments, careful package selection required"
    },
    "goals": [
      "Hardware-optimized kernel for HP Chromebook 14-SMB",
      "Minimal footprint within 16GB eMMC",
      "Full UEFI boot via MrChromebox",
      "tmux as multi-terminal interface — no GUI dependency",
      "VPN support entirely from CLI",
      "i915 driver retained for optional GUI path",
      "Debian minimal as clean, proven base"
    ],
    "non_goals": [
      "General-purpose multi-hardware support",
      "Heavy desktop environment",
      "Snap or Flatpak packages"
    ]
  }
}
