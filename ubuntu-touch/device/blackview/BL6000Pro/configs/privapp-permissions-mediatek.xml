<?xml version="1.0" encoding="utf-8"?>
<!--
  Privileged-permission allowlist for the MediaTek platform apps shipped in
  the stock BL6000 Pro firmware. Android 9+ enforces a strict allowlist for
  priv-apps; without this file the build/first boot logs
  "Privileged permission ... not in privapp-permissions allowlist" and the
  offending package fails to boot.

  Names below were read from vendor/blackview/BL6000Pro/system/priv-app in the
  stock dump. Trim to only the packages you actually carry into the port.
-->
<permissions>
    <privapp-permissions package="com.mediatek.engineermode">
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <permission name="android.permission.MODIFY_PHONE_STATE"/>
    </privapp-permissions>

    <privapp-permissions package="com.mediatek.op09cl">
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
    </privapp-permissions>

    <privapp-permissions package="com.android.settings">
        <permission name="android.permission.MANAGE_USB"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
    </privapp-permissions>

    <privapp-permissions package="com.android.systemui">
        <permission name="android.permission.BATTERY_STATS"/>
        <permission name="android.permission.STATUS_BAR_SERVICE"/>
    </privapp-permissions>

    <privapp-permissions package="com.mediatek.ygps">
        <permission name="android.permission.ACCESS_FINE_LOCATION"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
    </privapp-permissions>
</permissions>
