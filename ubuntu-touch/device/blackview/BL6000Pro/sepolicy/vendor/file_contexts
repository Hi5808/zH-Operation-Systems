# Vendor file contexts for the Blackview BL6000 Pro.
#
# Label the MediaTek vendor device nodes and HAL sockets so the Halium/hybris
# domains can reach them. Extend as you bring up each subsystem.

# MediaTek block devices (super / dynamic partitions)
/dev/block/platform/bootdevice/by-name/super      u:object_r:block_device:s0
/dev/block/platform/bootdevice/by-name/userdata   u:object_r:userdata_block_device:s0
/dev/block/platform/bootdevice/by-name/metadata   u:object_r:metadata_block_device:s0

# Connectivity (CONSYS_6873 combo: WiFi/BT/GPS/FM)
/dev/stpbt      u:object_r:bt_device:s0
/dev/stpgps     u:object_r:gps_device:s0
/dev/stpwmt     u:object_r:wmt_device:s0
/dev/stpant     u:object_r:ant_device:s0
/dev/fm         u:object_r:fm_device:s0

# Display / GPU (Mali-G57, MediaTek DRM)
/dev/mali0      u:object_r:gpu_device:s0
/dev/dri/card0  u:object_r:gpu_device:s0
/dev/dri/renderD128 u:object_r:gpu_device:s0

# Fingerprint (Sunwave / FPS)
/dev/goodix_fp  u:object_r:fingerprint_device:s0
