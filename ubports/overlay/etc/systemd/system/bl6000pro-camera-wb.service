[Unit]
Description=BL6000 Pro: libaalcamera with white-balance control
DefaultDependencies=no
After=local-fs.target
Before=lightdm.service lomiri.service
ConditionPathExists=/usr/lib/aarch64-linux-gnu/qt5/plugins/mediaservice/libaalcamera.so
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'T=/usr/lib/aarch64-linux-gnu/qt5/plugins/mediaservice/libaalcamera.so; F=/usr/lib/bl6000pro/camera/libaalcamera.so; [ -f /userdata/bl6000pro-camera/libaalcamera.so ] && F=/userdata/bl6000pro-camera/libaalcamera.so; [ -f /userdata/bl6000pro-camera/wb.off ] || mount --bind "$F" "$T"'
[Install]
WantedBy=multi-user.target
